{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/me.js": {
      "includeFiles": "dist-server/**"
    },
    "api/[[...path]].js": {
      "includeFiles": "dist-server/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
