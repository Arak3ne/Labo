{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist-server/**"
    },
    "api/validate-pattern.js": {
      "includeFiles": "dist-server/**"
    },
    "api/validate-host.js": {
      "includeFiles": "dist-server/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__labo_path=/api/:path*" },
    { "source": "/d07-submit", "destination": "/api?__labo_path=/api/d07-submit" },
    { "source": "/((?!api/|d07-submit).*)", "destination": "/index.html" }
  ]
}
