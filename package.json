{
  "name": "labo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/incubator/core/server/main.ts",
    "start:server": "tsx src/incubator/core/server/main.ts",
    "build:api": "vite build --config vite.server.config.ts",
    "build": "vue-tsc -b && tsc -p tsconfig.server.json && npm run build:api && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.40.1",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "@tresjs/post-processing": "^3.7.4",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vite-plugin-glsl": "^1.6.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
