# Optional server tuning.
LABO_SERVER_HOST=127.0.0.1
LABO_SERVER_PORT=8787
LABO_SESSION_TTL_MS=28800000
LABO_INCUBATION_TTL_MS=900000
LABO_SYNC_DURATION_MS=1800
LABO_ANALYSIS_DURATION_MS=8200
LABO_DISCONNECT_GRACE_MS=150
LABO_PARTICIPANT_DISCONNECT_GRACE_MS=30000
LABO_RATE_LIMIT_WINDOW_MS=60000
LABO_LOGIN_RATE_LIMIT_MAX=8
LABO_JOIN_RATE_LIMIT_MAX=12
# Durable single-process access-grant ledger (contains grant IDs only).
# Multi-instance deployments require a shared transactional implementation.
LABO_ACCESS_LEDGER_PATH=.data/incubator-access-ledger.json

# Optional local Vite proxy target (contains no credential).
VITE_INCUBATOR_SERVER_TARGET=http://127.0.0.1:8787
# Browser mocks are disabled unless explicitly enabled for playground work.
VITE_INCUBATOR_USE_MOCK=false
